<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/home_bg"
    android:paddingLeft="20dp"
    android:paddingRight="20dp"
    android:paddingTop="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Top Header & Search Bar Container -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="56dp">

            <!-- Normal Header -->
            <LinearLayout
                android:id="@+id/normal_header"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/header_title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="My Gists"
                    android:textColor="@color/home_text"
                    android:textSize="28sp"
                    android:textStyle="bold" />

                <ImageButton
                    android:id="@+id/search_button"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Search notes"
                    android:padding="12dp"
                    android:src="@drawable/ic_search"
                    android:tint="@color/home_muted" />

                <ImageButton
                    android:id="@+id/view_toggle_button"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Switch to grid view"
                    android:padding="12dp"
                    android:src="@drawable/ic_grid_view"
                    android:tint="@color/home_muted" />

                <ImageButton
                    android:id="@+id/settings_button"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Settings"
                    android:padding="12dp"
                    android:src="@drawable/ic_settings_home"
                    android:tint="@color/home_muted" />
            </LinearLayout>

            <!-- Expanded Search Bar -->
            <LinearLayout
                android:id="@+id/search_header"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_gravity="center_vertical"
                android:background="@drawable/search_bar_background"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:visibility="gone">

                <ImageButton
                    android:id="@+id/search_close_button"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Close search"
                    android:padding="8dp"
                    android:src="@drawable/ic_close"
                    android:tint="@color/home_muted" />

                <EditText
                    android:id="@+id/search_input"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@null"
                    android:hint="Search notes…"
                    android:imeOptions="actionSearch"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:singleLine="true"
                    android:textColor="@color/home_text"
                    android:textColorHint="@color/home_muted"
                    android:textSize="15sp" />

                <ImageButton
                    android:id="@+id/search_clear_button"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Clear search"
                    android:padding="9dp"
                    android:src="@drawable/ic_close"
                    android:tint="@color/home_muted"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- Selection Header -->
            <LinearLayout
                android:id="@+id/selection_header"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:visibility="gone">

                <ImageButton
                    android:id="@+id/selection_close_button"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Exit selection"
                    android:padding="10dp"
                    android:src="@drawable/ic_close"
                    android:tint="@color/home_text" />

                <TextView
                    android:id="@+id/selection_count_text"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:text="1 selected"
                    android:textColor="@color/home_text"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/selection_select_all"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:padding="8dp"
                    android:text="Select all"
                    android:textColor="@color/home_muted"
                    android:textSize="13sp" />

                <LinearLayout
                    android:id="@+id/selection_create_stack_button"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/pill_tab_selected"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:paddingStart="12dp"
                    android:paddingEnd="14dp">

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:src="@drawable/ic_layers"
                        android:tint="@color/home_bg" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:text="Create Stack"
                        android:textColor="@color/home_bg"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>
        </FrameLayout>

        <!-- Segmented note filters -->
        <LinearLayout
            android:id="@+id/tabs_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tab_pinned"
                android:layout_width="0dp"
                android:layout_height="34dp"
                android:layout_weight="1"
                android:background="@drawable/pill_tab_selected"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:text="Pinned"
                android:textColor="@color/home_bg"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tab_local"
                android:layout_width="0dp"
                android:layout_height="34dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:background="@drawable/pill_tab_unselected"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:text="Local"
                android:textColor="@color/home_muted"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tab_all"
                android:layout_width="0dp"
                android:layout_height="34dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:background="@drawable/pill_tab_unselected"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:text="All"
                android:textColor="@color/home_muted"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tab_archived"
                android:layout_width="0dp"
                android:layout_height="34dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1.25"
                android:background="@drawable/pill_tab_unselected"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:text="Archived"
                android:textColor="@color/home_muted"
                android:textSize="13sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/status_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textColor="@color/home_muted"
            android:textSize="13.5sp"
            android:visibility="gone" />

        <GridView
            android:id="@+id/gist_list"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="14dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:horizontalSpacing="12dp"
            android:paddingBottom="156dp"
            android:verticalSpacing="12dp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/fab_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="4dp"
        android:layout_marginBottom="24dp"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <ImageButton
            android:id="@+id/refresh_button"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginBottom="12dp"
            android:background="@drawable/fab_secondary"
            android:contentDescription="Refresh gists"
            android:elevation="4dp"
            android:padding="12dp"
            android:src="@drawable/ic_refresh_home"
            android:tint="@color/home_text" />

        <ImageButton
            android:id="@+id/create_button"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:background="@drawable/fab_primary"
            android:contentDescription="Create note"
            android:elevation="6dp"
            android:padding="16dp"
            android:src="@drawable/ic_add_home"
            android:tint="@color/home_bg" />
    </LinearLayout>
</FrameLayout>
