<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:id="@+id/diff_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Note Changed Elsewhere"
        android:textColor="@color/ink"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/diff_subtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="12dp"
        android:text="GitHub has newer changes. Compare the differences below before choosing what to keep."
        android:textColor="@color/muted"
        android:textSize="13sp" />

    <!-- View Mode Selector -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:layout_marginBottom="10dp"
        android:background="#14888888"
        android:orientation="horizontal"
        android:padding="2dp">

        <Button
            android:id="@+id/btn_mode_diff"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="Diff View"
            android:textAllCaps="false"
            android:textColor="@color/ink"
            android:textSize="12sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btn_mode_local"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="Device Copy"
            android:textAllCaps="false"
            android:textColor="@color/muted"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btn_mode_remote"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="GitHub Copy"
            android:textAllCaps="false"
            android:textColor="@color/muted"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- Scrollable content area -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="260dp"
        android:background="#0A888888"
        android:padding="8dp">

        <LinearLayout
            android:id="@+id/diff_content_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </ScrollView>

    <!-- Actions -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="end"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btn_keep_editing"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="6dp"
            android:text="Keep Editing"
            android:textAllCaps="false"
            android:textColor="@color/muted" />

        <Button
            android:id="@+id/btn_use_github"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="6dp"
            android:text="Use GitHub Copy"
            android:textAllCaps="false"
            android:textColor="@color/ink" />

        <Button
            android:id="@+id/btn_keep_device"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:backgroundTint="@color/focus_accent"
            android:text="Keep Device Copy"
            android:textAllCaps="false"
            android:textColor="@android:color/white" />
    </LinearLayout>
</LinearLayout>
