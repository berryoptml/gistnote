<resources>
    <style name="Theme.GistNote.Appearance" parent="Theme.GistNote">
        <item name="android:windowIsFloating">true</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:backgroundDimEnabled">false</item>
        <item name="android:windowNoTitle">true</item>
    </style>
    <style name="Theme.GistNote" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">@color/brand</item>
        <item name="android:navigationBarColor">@color/surface</item>
        <item name="android:statusBarColor">@color/surface</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowActionModeOverlay">true</item>
    </style>

    <style name="Theme.GistNote.Overlay" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:windowIsFloating">false</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">@color/brand</item>
        <item name="android:statusBarColor">@color/overlay_bar</item>
        <item name="android:navigationBarColor">@color/overlay_nav</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <style name="GistNote.Button" parent="android:style/Widget.Material.Button">
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/on_brand</item>
        <item name="android:backgroundTint">@color/brand</item>
        <item name="android:minHeight">48dp</item>
    </style>

    <style name="GistNote.SecondaryButton" parent="android:style/Widget.Material.Button">
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/brand_dark</item>
        <item name="android:backgroundTint">@color/surface_alt</item>
        <item name="android:minHeight">48dp</item>
    </style>

    <style name="GistNote.Field" parent="android:style/Widget.Material.EditText">
        <item name="android:background">@drawable/field_bg</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:textColorHint">@color/muted</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:paddingLeft">12dp</item>
        <item name="android:paddingRight">12dp</item>
    </style>

    <style name="GistNote.Label" parent="android:style/Widget.Material.TextView">
        <item name="android:textColor">@color/brand_dark</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="GistNote.ToolbarButton" parent="android:style/Widget.Material.Button">
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/on_surface</item>
        <item name="android:backgroundTint">@color/surface_alt</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:paddingLeft">12dp</item>
        <item name="android:paddingRight">12dp</item>
    </style>

    <style name="GistNote.ToolbarCommitButton" parent="android:style/Widget.Material.Button">
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@android:color/white</item>
        <item name="android:backgroundTint">@color/focus_accent</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:paddingLeft">16dp</item>
        <item name="android:paddingRight">16dp</item>
    </style>

    <style name="GistNote.ToolbarIconButton" parent="android:style/Widget.Material.ImageButton">
        <item name="android:layout_width">36dp</item>
        <item name="android:layout_height">36dp</item>
        <item name="android:background">?android:attr/selectableItemBackgroundBorderless</item>
        <item name="android:padding">6dp</item>
        <item name="android:tint">@color/toolbar_text</item>
        <item name="android:elevation">0dp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>
</resources>
